# Copy this file to .env. Never commit .env or share your bot token in chat.
# Values are literal: no shell evaluation or ${VARIABLE} expansion.
TELEGRAM_BOT_TOKEN=

# REQUIRED in private mode. Comma-separated numeric chat IDs, e.g. a private
# user ID or a negative group ID. No personal ID is included in this example.
TELEGRAM_CHAT_IDS=
BOT_PUBLIC=false

# Optional: restrict which members of an allowed group may use the bot.
BOT_ALLOWED_USER_IDS=
IPTV_REPO=4kings6114/IPTV
IPTV_BRANCH=main
IPTV_DASHBOARD_URL=https://4kings6114.github.io/IPTV/
BOT_STATE_DIR=.cache/telegram-bot
BOT_POLL_TIMEOUT=30
BOT_HTTP_TIMEOUT=20
BOT_RATE_LIMIT=10
BOT_RATE_WINDOW=30
BOT_GLOBAL_RATE_LIMIT=120
BOT_LOG_LEVEL=INFO
