# Example only: create an unprivileged iptvbot user and install under /opt/iptv.
# Keep /etc/iptv-telegram-bot.env private; do not copy credentials into this file.
[Unit]
Description=IPTV interactive Telegram bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=iptvbot
Group=iptvbot
WorkingDirectory=/opt/iptv
EnvironmentFile=/etc/iptv-telegram-bot.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/iptv/telegram_bot.py --state-dir /var/lib/iptv-telegram-bot
StateDirectory=iptv-telegram-bot
StateDirectoryMode=0700
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=10
TimeoutStopSec=65
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
